{
  "name": "market-diary-terminal",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cd apps/web-antd && vite --mode development",
    "build": "cd apps/web-antd && vite build --mode production",
    "preview": "cd apps/web-antd && vite preview",
    "typecheck": "vue-tsc --noEmit --skipLibCheck -p apps/web-antd/tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint apps/web-antd/src tests",
    "check": "vue-tsc --noEmit --skipLibCheck -p apps/web-antd/tsconfig.json && vitest run && cd apps/web-antd && vite build --mode production",
    "postinstall": "corepack pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tsdown/css": "catalog:",
    "@types/node": "catalog:",
    "@vben/eslint-config": "workspace:*",
    "@vben/oxfmt-config": "workspace:*",
    "@vben/oxlint-config": "workspace:*",
    "@vben/stylelint-config": "workspace:*",
    "@vben/tailwind-config": "workspace:*",
    "@vben/tsconfig": "workspace:*",
    "@vben/vite-config": "workspace:*",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": "22.18.x",
    "pnpm": "11.16.x"
  },
  "packageManager": "pnpm@11.16.0"
}
